[Unit]
Description=Personal Search Vault (M0 deploy probe)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=azureuser
WorkingDirectory=/home/azureuser/personal-search-vault
# Bind to loopback only; Caddy is the public listener.
Environment=GRADIO_SERVER_NAME=127.0.0.1
Environment=GRADIO_SERVER_PORT=7860
Environment=GRADIO_ANALYTICS_ENABLED=False
Environment=FASTEMBED_CACHE_PATH=/home/azureuser/personal-search-vault/data/models
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/azureuser/personal-search-vault/.venv/bin/python probe/app.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
